# 环境变量示例
# 复制此文件为 .env 并填入 API Key；不要把真实 Key 写进 TOML 或提交。

# RAG embeddings（智谱只用于 embedding-3；不要把对话或视觉模型写进这里）
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=2048

# DeepSeek（独立的非中文 → 中文翻译后端；不要复用 GLM Key）
TRANSLATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_TIMEOUT=120
TRANSLATION_CONCURRENCY=16

# 本地 vLLM 翻译后端（deploy/local-llm/docker-compose.yml）
# pipeline.toml 的 translation_profile = "local_llm" 时生效；
# 或 CLI --translation-provider local / TRANSLATION_PROVIDER=local。
LOCAL_LLM_API_BASE=http://127.0.0.1:8010/v1
LOCAL_LLM_MODEL=Intel/Hy-MT2-30B-A3B-int4-AutoRound
# 仅当 vLLM 以 --api-key 启动时需要；默认本地无鉴权，留空即可。
# LOCAL_LLM_API_KEY=

# MIMO（可选 OCR）
MIMO_API_KEY=your-api-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# SEED（备选 OCR）
SEED_API_KEY=your-api-key-here
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses
SEED_MODEL=doubao-seed-2-0-lite-260215
