# 环境变量示例
# 复制此文件为 .env 并填入 API Key；不要把真实 Key 写进 TOML 或提交。

# Magpie 本地网关（OpenAI 兼容）：OCR / 目录 / 校勘 / 翻译四个阶段共用
MAGPIE_API_KEY=your-magpie-key-here
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_MODEL=mistral/deepseek-v4-1-flash-1017
OCR_BACKEND=auto
OCR_CONCURRENCY=4

# 可选：不通过 profile 而用环境变量指定视觉 OCR 端点
# OPENAI_VISION_BASE_URL=http://127.0.0.1:3425/v1
# OPENAI_VISION_MODEL=mistral/deepseek-v4-1-flash-1017
# OPENAI_VISION_TIMEOUT=180
# OPENAI_VISION_MAX_TOKENS=8192

# RAG embeddings (智谱 OpenAI-compatible API; never commit a real key)
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=2048

# DeepSeek（独立的非中文 → 中文翻译后端；不要复用 GLM Key）
TRANSLATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_TIMEOUT=120
TRANSLATION_CONCURRENCY=16

# MIMO（可选 OCR）
MIMO_API_KEY=your-api-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# SEED（备选 OCR）
SEED_API_KEY=your-api-key-here
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses
SEED_MODEL=doubao-seed-2-0-lite-260215
