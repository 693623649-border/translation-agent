# 环境变量示例
# 复制此文件为 .env 并填入你的 API Key

# GLM Coding Plan（视觉 MCP OCR + 目录解析）
# 密钥只放在本地 .env 或进程环境中，不要写进命令、源码或提交记录。
GLM_API_MODE=coding-plan
GLM_CODING_API_KEY=your-coding-plan-key-here
GLM_CODING_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
GLM_TEXT_MODEL=glm-5.2
OCR_BACKEND=coding-plan-mcp
CODING_PLAN_VISION_MCP_COMMAND=npx -y @z_ai/mcp-server@latest
OCR_CONCURRENCY=4

# 可选：标准 GLM-OCR API（不属于 Coding Plan 套餐，通常不需要配置）
# GLM_OCR_API_KEY=your-standard-api-key-here
# GLM_OCR_API_BASE=https://open.bigmodel.cn/api/paas/v4
# GLM_OCR_MODEL=glm-ocr

# DeepSeek（独立的非中文 → 中文翻译后端；不要复用 GLM Key）
TRANSLATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_TIMEOUT=120
TRANSLATION_CONCURRENCY=16

# MIMO (OCR)
MIMO_API_KEY=your-api-key-here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# SEED (备选 OCR)
SEED_API_KEY=your-api-key-here
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses
SEED_MODEL=doubao-seed-2-0-lite-260215
