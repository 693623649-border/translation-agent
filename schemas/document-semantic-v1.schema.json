{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://translation-agent.local/schemas/document-semantic-v1.schema.json",
  "title": "Translation Agent DocumentSemantic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_mode",
    "source_sha256",
    "source_language",
    "chapters",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "source_mode": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_language": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "items": {"type": "object"}},
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sequence", "title", "blocks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "markdown", "locators", "metadata"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {
                  "enum": [
                    "heading",
                    "paragraph",
                    "quote",
                    "list_item",
                    "table",
                    "image",
                    "footnote_definition",
                    "pagebreak",
                    "index_entry",
                    "bibliography_entry"
                  ]
                },
                "markdown": {"type": "string", "minLength": 1},
                "metadata": {"type": "object"},
                "locators": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["adapter", "source"],
                    "properties": {
                      "adapter": {"type": "string", "minLength": 1},
                      "source": {"type": "string", "minLength": 1},
                      "page": {"type": ["integer", "null"], "minimum": 1},
                      "href": {"type": ["string", "null"]},
                      "anchor": {"type": ["string", "null"]},
                      "block_index": {"type": ["integer", "null"], "minimum": 0}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

